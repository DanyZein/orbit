orbit-backups/
*-backups/
backups/
*backup*.jsx
*backup*.js
orbit copy.*
*.bundle
*.bak

# One-off scratch scripts, not part of the app
src/random/

# Chat exports and anything dragged in from elsewhere
chat-export*.json

